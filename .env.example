# Browser exercise enabled by default. Set disabled to stop exercise operations.
LAB_RUNTIME_MODE=simulator

# Optional: 64 hex characters to keep encrypted sessions valid across deployments.
# Without this setting, npm run build prepares a private per-deployment key.
# Set this so saved answers survive updates (redeployments).
# AQUA_SESSION_KEY=
# When rotating the key, move old keys here (comma-separated). They are used for decryption only.
# AQUA_SESSION_KEY_PREVIOUS=
