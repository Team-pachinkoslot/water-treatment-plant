{
  "name": "ics-lab-aqua",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:simulator": "LAB_RUNTIME_MODE=simulator next dev --hostname 127.0.0.1",
